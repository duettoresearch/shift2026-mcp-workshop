# Required for npm run agent (and live LLM evals if enabled)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override mock API / MCP HTTP ports
API_PORT=3847
MCP_HTTP_PORT=3848

# Demo hotel used by scenarios and the agent
HOTEL_ID=HARBOR-01

# Scenario seed for the in-process engine: baseline | demand-spike | unfilled-block | noise
SCENARIO=baseline
